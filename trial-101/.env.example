# Copy to .env.local for local development, or set these in Netlify.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Both Supabase keys below are PUBLIC identifiers. Never put a service-role
# key or the Midtrans server key in this file.

# --- Supabase project (use the production project for Netlify) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# --- Midtrans public client key (browser side only) ---
# The server key belongs in Supabase Edge Function secrets.
VITE_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# Local development: sandbox. Netlify production: production.
VITE_MIDTRANS_ENV=sandbox
